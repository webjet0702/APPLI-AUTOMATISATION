# Copiez ce fichier en .env.local puis remplissez les valeurs.

# Clé API Claude (https://console.anthropic.com) : nécessaire pour lire de vraies factures.
# Sans clé, la démo fonctionne quand même.
ANTHROPIC_API_KEY=

# Mot de passe pour accéder à l'appli. Obligatoire une fois l'appli en ligne.
APP_PASSWORD=

# Base Postgres (par exemple Supabase). Vide = base locale dans le dossier .data/
DATABASE_URL=

# Modèle Claude utilisé pour lire les factures.
CLAUDE_MODEL=claude-opus-5-5
